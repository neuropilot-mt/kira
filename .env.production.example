APP_NAME="Kira Novikova"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.laravel.cloud

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# Базу не подключайте и DB_* не задавайте.
# Список фото лежит в бакете, в photos/catalog.json.
# Cloud выставит FILESYSTEM_DISK, когда бакет назначен диском по умолчанию.

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
CACHE_STORE=file

ADMIN_EMAIL=
ADMIN_PASSWORD=
